== Stats
# pool queries
QUERY: SELECT tenant_id FROM gobricks_inbox_hold_tenant WHERE consumer = $1
  arg[0] string = orders
QUERY: SELECT consumer, tenant_id, held_since, attempts, next_attempt_at, COALESCE(last_error, '') FROM gobricks_inbox_hold_tenant WHERE consumer = $1 ORDER BY held_since
  arg[0] string = orders
QUERY: SELECT consumer, tenant_id, held_since, attempts, next_attempt_at, COALESCE(last_error, '') FROM gobricks_inbox_hold_tenant WHERE (consumer = $1 AND next_attempt_at <= NOW() AND (lease_until IS NULL OR lease_until < NOW())) ORDER BY held_since LIMIT 10
  arg[0] string = orders
QUERY: SELECT consumer, stream, stream_offset, tenant_id, data, properties, held_at FROM gobricks_inbox_hold WHERE (consumer = $1 AND tenant_id = $2) ORDER BY stream, stream_offset LIMIT 5
  arg[0] string = orders
  arg[1] string = acme
QUERY: SELECT (SELECT COUNT(*) FROM gobricks_inbox_hold_tenant WHERE consumer = $1) AS tenants, (SELECT COUNT(*) FROM gobricks_inbox_hold WHERE consumer = $2) AS held_rows, (SELECT MIN(held_since) FROM gobricks_inbox_hold_tenant WHERE consumer = $3) AS oldest
  arg[0] string = orders
  arg[1] string = orders
  arg[2] string = orders
# pool execs
EXEC: 
CREATE TABLE IF NOT EXISTS gobricks_inbox_hold (
    consumer      VARCHAR(255) NOT NULL,
    stream        VARCHAR(255) NOT NULL,
    stream_offset BIGINT       NOT NULL,
    tenant_id     VARCHAR(255) NOT NULL,
    data          BYTEA,
    properties    BYTEA,
    held_at       TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    PRIMARY KEY (consumer, stream, stream_offset)
)
EXEC: 
CREATE TABLE IF NOT EXISTS gobricks_inbox_hold_tenant (
    consumer        VARCHAR(255) NOT NULL,
    tenant_id       VARCHAR(255) NOT NULL,
    held_since      TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    attempts        INTEGER      NOT NULL DEFAULT 0,
    next_attempt_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    last_error      TEXT,
    lease_owner     VARCHAR(255),
    lease_until     TIMESTAMP WITH TIME ZONE,
    PRIMARY KEY (consumer, tenant_id)
)
EXEC: 
CREATE INDEX IF NOT EXISTS idx_gobricks_inbox_hold_tenant_order ON gobricks_inbox_hold (consumer, tenant_id, stream, stream_offset)
EXEC: 
CREATE INDEX IF NOT EXISTS idx_gobricks_inbox_hold_tenant_due ON gobricks_inbox_hold_tenant (consumer, next_attempt_at)
EXEC: UPDATE gobricks_inbox_hold_tenant SET lease_owner = $1, lease_until = NOW() + ($2 * INTERVAL '1 second') WHERE (consumer = $3 AND tenant_id = $4 AND (lease_until IS NULL OR lease_until < NOW() OR lease_owner = $5))
  arg[0] string = owner-1
  arg[1] float64 = 30
  arg[2] string = orders
  arg[3] string = acme
  arg[4] string = owner-1
EXEC: DELETE FROM gobricks_inbox_hold WHERE (consumer = $1 AND stream = $2 AND stream_offset = $3 AND EXISTS (SELECT 1 FROM gobricks_inbox_hold_tenant WHERE (consumer = $4 AND tenant_id = $5 AND lease_owner = $6 AND lease_until > NOW())))
  arg[0] string = orders
  arg[1] string = orders-s
  arg[2] int64 = 7
  arg[3] string = orders
  arg[4] string = acme
  arg[5] string = owner-1
EXEC: UPDATE gobricks_inbox_hold_tenant SET attempts = attempts + 1, next_attempt_at = NOW() + ($1 * INTERVAL '1 second'), last_error = $2, lease_owner = NULL, lease_until = NULL WHERE (consumer = $3 AND tenant_id = $4 AND lease_owner = $5 AND lease_until > NOW())
  arg[0] float64 = 45
  arg[1] string = boom
  arg[2] string = orders
  arg[3] string = acme
  arg[4] string = owner-1
EXEC: UPDATE gobricks_inbox_hold_tenant SET lease_owner = $1, lease_until = $2 WHERE (consumer = $3 AND tenant_id = $4 AND lease_owner = $5)
  arg[0] <nil> = <nil>
  arg[1] <nil> = <nil>
  arg[2] string = orders
  arg[3] string = acme
  arg[4] string = owner-1
EXEC: DELETE FROM gobricks_inbox_hold_tenant WHERE (consumer = $1 AND tenant_id = $2 AND lease_owner = $3 AND lease_until > NOW() AND NOT EXISTS (SELECT 1 FROM gobricks_inbox_hold WHERE (consumer = $4 AND tenant_id = $5)))
  arg[0] string = orders
  arg[1] string = acme
  arg[2] string = owner-1
  arg[3] string = orders
  arg[4] string = acme
# tx[0] queries
# tx[0] execs
EXEC: INSERT INTO gobricks_inbox_hold_tenant (consumer, tenant_id) VALUES ($1, $2)
		 ON CONFLICT (consumer, tenant_id) DO UPDATE SET consumer = EXCLUDED.consumer
  arg[0] string = orders
  arg[1] string = acme
EXEC: INSERT INTO gobricks_inbox_hold ("consumer","data","properties","stream","stream_offset","tenant_id") VALUES ($1,$2,$3,$4,$5,$6) ON CONFLICT ("consumer", "stream", "stream_offset") DO NOTHING
  arg[0] string = orders
  arg[1] []uint8 = {"id":1}
  arg[2] []uint8 = {"k":"v"}
  arg[3] string = orders-s
  arg[4] int64 = 7
  arg[5] string = acme
