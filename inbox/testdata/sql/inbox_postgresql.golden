CREATE TABLE IF NOT EXISTS gobricks_inbox (
    tenant_id     VARCHAR(255) NOT NULL DEFAULT '',
    event_id      VARCHAR(255) NOT NULL,
    processed_at  TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    PRIMARY KEY (tenant_id, event_id)
)
