# pool queries
QUERY: SELECT id, event_type, aggregate_id, payload, headers, exchange, routing_key, lane, stream, partition_key, status, retry_count, created_at, seq FROM gobricks_outbox WHERE status = :1 ORDER BY seq ASC FETCH NEXT 25 ROWS ONLY
  arg[0] string = pending
# pool execs
EXEC: 
CREATE TABLE gobricks_outbox (
    id            VARCHAR2(36) PRIMARY KEY,
    seq           NUMBER(19) GENERATED BY DEFAULT AS IDENTITY,
    lane          VARCHAR2(16) DEFAULT 'amqp' NOT NULL,
    event_type    VARCHAR2(255) NOT NULL,
    aggregate_id  VARCHAR2(255) NOT NULL,
    payload       BLOB NOT NULL,
    headers       BLOB,
    -- Nullable: Oracle treats '' as NULL, so a DEFAULT '' NOT NULL is self-contradictory and
    -- rejects events targeting the AMQP default (empty) exchange with ORA-01400. FetchPending
    -- maps the resulting NULL back to "" on scan. See issue #586.
    exchange      VARCHAR2(255),
    routing_key   VARCHAR2(255),
    stream        VARCHAR2(255),
    partition_key VARCHAR2(255),
    status        VARCHAR2(20) DEFAULT 'pending' NOT NULL,
    retry_count   NUMBER(10) DEFAULT 0 NOT NULL,
    error_msg     CLOB,
    created_at    TIMESTAMP WITH TIME ZONE DEFAULT SYSTIMESTAMP NOT NULL,
    published_at  TIMESTAMP WITH TIME ZONE
)
EXEC: 
CREATE INDEX idx_gobricks_outbox_pending ON gobricks_outbox (
    CASE WHEN status = 'pending' THEN seq END
)
EXEC: 
CREATE INDEX idx_gobricks_outbox_published ON gobricks_outbox (
    CASE WHEN status = 'published' THEN published_at END
)
EXEC: CREATE TABLE gobricks_outbox_leader (id NUMBER(3) PRIMARY KEY)
EXEC: MERGE INTO gobricks_outbox_leader t USING (SELECT 1 AS id FROM dual) s ON (t.id = s.id) WHEN NOT MATCHED THEN INSERT (id) VALUES (s.id)
EXEC: UPDATE gobricks_outbox SET status = :1, published_at = :2 WHERE id = :3
  arg[0] string = published
  arg[1] time.Time = <time>
  arg[2] string = 11111111-2222-4333-8444-555555555555
EXEC: UPDATE gobricks_outbox SET retry_count = retry_count + 1, error_msg = :1 WHERE id = :2
  arg[0] string = broker down
  arg[1] string = 11111111-2222-4333-8444-555555555555
EXEC: UPDATE gobricks_outbox SET retry_count = retry_count + 1, status = :1, error_msg = :2 WHERE id = :3
  arg[0] string = failed
  arg[1] string = poison
  arg[2] string = 11111111-2222-4333-8444-555555555555
EXEC: DELETE FROM gobricks_outbox WHERE (status = :1 AND published_at < :2)
  arg[0] string = published
  arg[1] time.Time = 2026-09-04T12:00:00Z
