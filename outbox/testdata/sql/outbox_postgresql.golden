# pool queries
QUERY: SELECT id, event_type, aggregate_id, payload, headers, exchange, routing_key, lane, stream, partition_key, status, retry_count, created_at, seq FROM gobricks_outbox WHERE status = $1 ORDER BY seq ASC LIMIT 25
  arg[0] string = pending
# pool execs
EXEC: 
CREATE TABLE IF NOT EXISTS gobricks_outbox (
    id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    seq           BIGINT GENERATED BY DEFAULT AS IDENTITY,
    lane          VARCHAR(16) NOT NULL DEFAULT 'amqp',
    event_type    VARCHAR(255) NOT NULL,
    aggregate_id  VARCHAR(255) NOT NULL,
    payload       BYTEA NOT NULL,
    headers       BYTEA,
    exchange      VARCHAR(255) NOT NULL DEFAULT '',
    routing_key   VARCHAR(255) NOT NULL DEFAULT '',
    stream        VARCHAR(255) NOT NULL DEFAULT '',
    partition_key VARCHAR(255) NOT NULL DEFAULT '',
    status        VARCHAR(20) NOT NULL DEFAULT 'pending',
    retry_count   INTEGER NOT NULL DEFAULT 0,
    error         TEXT,
    created_at    TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    published_at  TIMESTAMP WITH TIME ZONE
)
EXEC: 
CREATE INDEX IF NOT EXISTS idx_gobricks_outbox_pending
    ON gobricks_outbox (seq) WHERE status = 'pending'
EXEC: 
CREATE INDEX IF NOT EXISTS idx_gobricks_outbox_published
    ON gobricks_outbox (published_at) WHERE status = 'published'
EXEC: CREATE TABLE IF NOT EXISTS gobricks_outbox_leader (id SMALLINT PRIMARY KEY)
EXEC: INSERT INTO gobricks_outbox_leader (id) VALUES (1) ON CONFLICT (id) DO NOTHING
EXEC: UPDATE gobricks_outbox SET status = $1, published_at = $2 WHERE id = $3
  arg[0] string = published
  arg[1] time.Time = <time>
  arg[2] string = 11111111-2222-4333-8444-555555555555
EXEC: UPDATE gobricks_outbox SET retry_count = retry_count + 1, error = $1 WHERE id = $2
  arg[0] string = broker down
  arg[1] string = 11111111-2222-4333-8444-555555555555
EXEC: UPDATE gobricks_outbox SET retry_count = retry_count + 1, status = $1, error = $2 WHERE id = $3
  arg[0] string = failed
  arg[1] string = poison
  arg[2] string = 11111111-2222-4333-8444-555555555555
EXEC: DELETE FROM gobricks_outbox WHERE (status = $1 AND published_at < $2)
  arg[0] string = published
  arg[1] time.Time = 2026-09-04T12:00:00Z
